# Ignore everything
*

# Allow this file to always be tracked
!.gitignore

############ WP-CONTENT FILTER ############

# Allow wp-content directory itself
!wp-content/

# Ignore everything in wp-content unless allowed later
wp-content/*

# Allow themes folder
!wp-content/themes/

# Ignore everything inside themes except divi-child
wp-content/themes/*

# ⭐ REQUIRED — allow the folder itself
!wp-content/themes/divi-child/

# Allow ALL FILES inside divi-child
!wp-content/themes/divi-child/**

###########################################

# Ignore node_modules inside divi-child
wp-content/themes/divi-child/node_modules/

# Allow vscode config
!.vscode/
